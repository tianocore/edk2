[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = RngStandaloneMm
  FILE_GUID                      = EEC9D5F8-CCBD-4A5D-A30E-6E0058D936B1
  MODULE_TYPE                    = MM_STANDALONE
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x00010032
  ENTRY_POINT                    = RngStandaloneMmEntryPoint

#
# The following information is for reference only and not required by the build tools.
#
# VALID_ARCHITECTURES = IA32 X64 AARCH64
#

[Sources]
  RngStandaloneMm.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MmServicesTableLib
  RngLib
  StandaloneMmDriverEntryPoint

[Protocols]
  gEfiRngProtocolGuid  ## PRODUCES

[Depex]
  TRUE
