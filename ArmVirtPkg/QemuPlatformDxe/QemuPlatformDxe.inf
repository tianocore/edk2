[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = QemuPlatformDxe
  FILE_GUID                      = 30E617DC-3EB6-4225-B990-A5C22C87AC27
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = QemuPlatformDxeEntryPoint

[Sources]
  QemuPlatformDxe.c
  SsdtRtc.asl

[Packages]
