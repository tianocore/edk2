#  SPDX-License-Identifier: BSD-3-Clause-Clear
#  @file
#  Lz4CustomDecompressLib produces LZ4 custom decompression algorithm.
#  It is based on the LZ4 library (https://github.com/lz4/lz4)
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Lz4DecompressLib
  MODULE_UNI_FILE                = Lz4DecompressLib.uni
  FILE_GUID                      = 35194661-7421-44ad-9636-e44885f092d2
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = NULL
  CONSTRUCTOR                    = Lz4DecompressLibConstructor

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 AARCH64 ARM
#

[Sources]
  Lz4Decompress.c
  GuidedSectionExtraction.c
  Lz4DecompressLibInternal.h
  Lz4Format.h
  UefiLz4Compat.h
  lz4/lib/lz4.h
  lz4/lib/lz4.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[Guids]
  gLz4CustomDecompressGuid  ## PRODUCES  ## UNDEFINED # specifies LZ4 custom decompress algorithm.

[LibraryClasses]
  BaseLib
  DebugLib
  BaseMemoryLib
  ExtractGuidedSectionLib

[BuildOptions]
  # Disable standard C library dependencies for UEFI environment.
  # Force-include the UEFI compatibility shim so upstream lz4.c also sees the
  # freestanding memory macro mappings.
  GCC:*_*_*_CC_FLAGS = -include UefiLz4Compat.h -DLZ4_STATIC_LINKING_ONLY_DISABLE_MEMORY_ALLOCATION -DLZ4_FREESTANDING=1 -Wno-unused-function
  CLANGPDB:*_*_*_CC_FLAGS = -include UefiLz4Compat.h -DLZ4_STATIC_LINKING_ONLY_DISABLE_MEMORY_ALLOCATION -DLZ4_FREESTANDING=1 -Wno-unused-function
  CLANGDWARF:*_*_*_CC_FLAGS = -include UefiLz4Compat.h -DLZ4_STATIC_LINKING_ONLY_DISABLE_MEMORY_ALLOCATION -DLZ4_FREESTANDING=1 -Wno-unused-function
  MSFT:*_*_*_CC_FLAGS = /FIUefiLz4Compat.h /DLZ4_STATIC_LINKING_ONLY_DISABLE_MEMORY_ALLOCATION /DLZ4_FREESTANDING=1
