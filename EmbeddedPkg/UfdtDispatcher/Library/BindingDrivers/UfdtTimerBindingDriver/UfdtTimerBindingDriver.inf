[Defines]
  INF_VERSION                    = 1.30
  BASE_NAME                      = UfdtTimerBindingDriver
  FILE_GUID                      = c2d2aba7-3ddd-4bb3-b4ad-4f6c770381d9
  MODULE_TYPE                    = DXE_DRIVER
